<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sensors.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Spacing="25"
            Padding="30,0"
            VerticalOptions="Center">

            <Image
                Source="dotnet_bot.png"
                SemanticProperties.Description="Cute dot net bot waving hi to you!"
                HeightRequest="200"
                HorizontalOptions="Center" />

            <Label
                Text="Accelerometer"
                SemanticProperties.HeadingLevel="Level1"
                FontSize="Large"
                FontAttributes="Bold"
                HorizontalOptions="Start"
                />
            <Button
                x:Name="AccelBtn"
                Text="Toggle Accelerometer"
                Clicked="OnAccelClicked"
                HorizontalOptions="Start"
                
                />

            <Label
                x:Name="AccelLabel"
                Text="Disabled"
                SemanticProperties.HeadingLevel="Level2"
                FontSize="Body"
                HorizontalOptions="Start"
                />

            <Label
                Text="Gyroscope"
                SemanticProperties.HeadingLevel="Level1"
                FontSize="Large"
                FontAttributes="Bold"
                HorizontalOptions="Start"
                />

            <Button
                x:Name="GyroBtn"
                Text="Toggle Gyro"
                Clicked="ToggleGyroscope"
                HorizontalOptions="Start"
                />

            <Label
                x:Name="GyroscopeLabel"
                Text="Disabled"
                SemanticProperties.HeadingLevel="Level2"
                FontSize="Body"
                HorizontalOptions="Start"
                />
            
            <Label
                Text="Magnetometer"
                SemanticProperties.HeadingLevel="Level1"
                FontSize="Large"
                FontAttributes="Bold"
                HorizontalOptions="Start"
                />

            <Button
                x:Name="MagnBtn"
                Text="Toggle Magnetometer"
                Clicked="ToggleMagnetometer"
                HorizontalOptions="Start"
                />

            <Label
                x:Name="MagnetometerLabel"
                Text="Disabled"
                SemanticProperties.HeadingLevel="Level2"
                FontSize="Body"
                HorizontalOptions="Start"
                />

            <Label
                Text="Orientation"
                SemanticProperties.HeadingLevel="Level1"
                FontSize="Large"
                FontAttributes="Bold"
                HorizontalOptions="Start"
                />

            <Button
                x:Name="OrientBtn"
                Text="Toggle Orientation"
                Clicked="ToggleOrientation"
                HorizontalOptions="Start"
                />

            <Label
                x:Name="OrientationLabel"
                Text="Disabled"
                SemanticProperties.HeadingLevel="Level2"
                FontSize="Body"
                HorizontalOptions="Start"
                />


            <Label
                Text="Hello, World!"
                SemanticProperties.HeadingLevel="Level1"
                FontSize="32"
                HorizontalOptions="Center" />

            <Label
                Text="Welcome to .NET Multi-platform App UI"
                SemanticProperties.HeadingLevel="Level2"
                SemanticProperties.Description="Welcome to dot net Multi platform App U I"
                FontSize="18"
                HorizontalOptions="Center" />

            <Button
                x:Name="CounterBtn"
                Text="Click me"
                SemanticProperties.Hint="Counts the number of times you click"
                Clicked="OnCounterClicked"
                HorizontalOptions="Center" />
            
            <Button
                x:Name="SocketBtn"
                Text="Socket Setup"
                SemanticProperties.Hint="Setup the socket client"
                Clicked="OnSocketClicked"
                HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
