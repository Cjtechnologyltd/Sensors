<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sensors.SocketPage"
             Title="SocketPage">
    <VerticalStackLayout>
        <Label 
            Text="Socket Setup"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Label
            Text="IP Address"
            VerticalOptions="Center"
            HorizontalOptions="Start" />
        <Entry
           x:Name="ipad"
           Placeholder="192.168.1.94"
           Completed="OnIpAdCompleted" />
        <Label
            Text="Port"
            VerticalOptions="Center"
            HorizontalOptions="Start" />
        <Entry
           x:Name="port"
           Placeholder="8800"
           Completed="OnPortCompleted" />
        <Button
            x:Name="ConnectBtn"
                Text="Connect"
                SemanticProperties.Hint="Connect to socket server"
                Clicked="OnConnectClicked"
                HorizontalOptions="Center" />
        
    </VerticalStackLayout>
</ContentPage>